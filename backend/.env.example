# ============================================================================
# HUSHAE backend — LOCAL DEV ENVIRONMENT
# ============================================================================
# ⚠️⚠️  PRE-LAUNCH DEVELOPMENT CREDENTIALS  ⚠️⚠️
# These are the WORKING values used by the live store on Vercel right now, so
# a fresh local copy (download ZIP → extract → run) connects to the SAME
# MongoDB Atlas database and behaves exactly like https://hushae.vercel.app
#
# These credentials have been exposed in this repository's history during
# development. BEFORE the public launch you MUST rotate:
#   1. The MongoDB Atlas password   (cloud.mongodb.com → Database Access)
#   2. JWT_SECRET below             (any 64-char hex; sessions invalidate)
#   3. ADMIN_PASSWORD               (admin console login)
# Then update Vercel env vars AND this file, and commit only the new
# placeholders back to git.
# ============================================================================

# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database (Atlas — same cluster as production) ---
