# ============================================================================
# HUSHAE backend — LOCAL DEV ENVIRONMENT
# ============================================================================
# Copy this file to backend/.env and fill in YOUR OWN values.
#
# The live store's real credentials were rotated on 2026-08-16 and are stored
# ONLY as Vercel environment variables (Project → Settings → Environment
# Variables) — they are never committed to git. Never commit real secrets here.
# ============================================================================

# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database ---
# LEAVE THIS EMPTY to run with the embedded local MongoDB: the server downloads
# it once (~90 MB, cached afterwards) and needs no install or account. Data
# resets when the server stops — fine for trying the app out.
#
# For persistent/shared data, create a free cluster at https://cloud.mongodb.com,
# add a database user, allow your IP in Network Access, and paste YOUR string
# here, e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hushae
MONGODB_URI=

# --- Auth ---
# Any long random string (64 hex chars recommended). Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-64-char-hex-string
JWT_EXPIRES=7d

# --- Admin account (used only when seeding a FRESH empty database) ---
ADMIN_EMAIL=admin@yourstore.pk
ADMIN_PASSWORD=set-a-strong-password-here

# --- Seed control ---
# Set true ONLY to seed an empty database, then set back to false.
SEED_ON_START=false
