# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database ---
# Leave EMPTY for zero-config local development (an embedded MongoDB downloads & runs automatically).
# For production / shared data, paste your MongoDB Atlas connection string here, e.g.:
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/veloura
MONGODB_URI=

# --- Auth ---
JWT_SECRET=veloura-dev-secret-change-me-in-production
JWT_EXPIRES=7d

# --- Admin account (created by the seed script) ---
ADMIN_EMAIL=admin@veloura.pk
ADMIN_PASSWORD=VelouraAdmin@123
