# --- Auth ---
JWT_SECRET=15f3b78f0fae6e99b7a3b42972b0799c921798e6fb10176b10a9564e757f6f98
JWT_EXPIRES=7d

# --- Admin account (used only when seeding a FRESH empty database) ---
