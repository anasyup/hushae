# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database ---
# ⚠️ NEVER commit real credentials. Copy this file to .env and paste your
# real Atlas connection string there — .env is git-ignored.
# Local `npm run dev` connects to this and sees the SAME products/orders/settings.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hushae

# --- Auth ---
# JWT signing secret — generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRES=7d

# --- Admin account ---
# Used the FIRST time the DB is empty AND SEED_ON_START=true.
# Set your own strong password here (and on Vercel).
ADMIN_EMAIL=admin@yourstore.pk
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Seed control ---
# Set to "true" ONLY the first time you set up a fresh empty database.
# Never leave this "true" in normal use, otherwise a fresh empty DB will be
# repopulated with demo data on the next startup.
SEED_ON_START=false

# Backend API URL. In local dev the Vite proxy is used, so you can leave this as-is.
# For production (e.g. Render), set it to the deployed backend URL.
VITE_API_URL=http://localhost:4000
