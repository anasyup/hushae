# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database ---
# For local dev with your live cloud data, paste your MongoDB Atlas connection string here.
# Leave EMPTY only if you want an isolated in-memory embedded MongoDB (data is throwaway).
# Example: MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/hushae
MONGODB_URI=

# --- Auth ---
# JWT signing secret. Generate a long random string for production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# --- Admin account ---
# Only used the FIRST time the DB is empty AND SEED_ON_START=true (see below).
# For a live cloud DB (Atlas) the admin already exists — these are ignored.
ADMIN_EMAIL=admin@hushae.pk
ADMIN_PASSWORD=change-me

# --- Seed control ---
# Set to "true" ONLY the first time you set up a fresh empty database.
# Never leave this "true" in normal use, otherwise a fresh empty DB will be
# repopulated with demo data on the next startup.
SEED_ON_START=false
