# Local defaults. start-dev copies this to backend/.env if missing.
# Live secrets stay on Vercel — never commit a real .env.

PORT=4000
CLIENT_URL=http://localhost:5173

# EMPTY = embedded in-memory Mongo (no Atlas / no mongod install needed).
MONGODB_URI=

JWT_SECRET=local-dev-jwt-secret-hushae-change-me
JWT_EXPIRES=7d

ADMIN_EMAIL=admin@hushae.local
ADMIN_PASSWORD=admin123
SEED_ON_START=true
